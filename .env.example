# Copy to .env and fill in. .env is gitignored and never committed.

# OpenAQ v3 API key (free account at https://explore.openaq.org)
OPENAQ_API_KEY=

# Centre of the PM2.5 station search (25 km radius).
# Defaults to Lucknow city centre; put your own area in .env.
CENTER_LAT=26.8467
CENTER_LON=80.9462
